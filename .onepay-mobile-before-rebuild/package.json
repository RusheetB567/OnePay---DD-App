{
  "name": "onepay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx backend/main.ts",
    "dev:demo": "node server.js",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:web": "npm --prefix apps/mobile run web",
    "start": "tsx backend/main.ts",
    "db:migrate": "tsx backend/migrate.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.js tests/*.test.ts",
    "check": "tsc --noEmit && node --check src/app.js && node --check src/finance.js && node --check server.js",
    "check:mobile": "npm --prefix apps/mobile run typecheck",
    "build": "tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.71.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
